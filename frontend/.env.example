# HanVoice frontend — copy to .env and fill in from your Supabase project.
# Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend origin. Leave empty in dev — Vite proxies /api to localhost:8000.
VITE_API_URL=

# Optional: PostHog product analytics (no-op when empty). EU cloud by default.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Optional: Sentry error monitoring (no-op when empty).
VITE_SENTRY_DSN=
